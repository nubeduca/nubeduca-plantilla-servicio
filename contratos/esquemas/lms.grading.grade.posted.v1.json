{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "lms.grading.grade.posted.v1",
  "description": "La nota quedó publicada para el alumno. Va al bus y además a SNS FIFO para llegar en orden por curso. Este esquema describe el campo detail del evento de EventBridge.",
  "type": "object",
  "required": [
    "metadata",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Datos comunes a todos los eventos. Los llena la plantilla de servicio (LIB-01).",
      "required": [
        "eventId",
        "tenantId",
        "occurredAt",
        "aggregateType",
        "aggregateId",
        "aggregateVersion",
        "actorId",
        "courseId"
      ],
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID único del evento. El consumidor lo guarda para descartar duplicados."
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,32}$",
          "description": "Identificador del tenant: utec, upc o pucp. Sale del token, nunca del body."
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Momento del cambio en UTC (ISO 8601)."
        },
        "aggregateType": {
          "type": "string",
          "enum": [
            "grade"
          ],
          "description": "Entidad dueña del cambio: course, enrollment, grade, etc."
        },
        "aggregateId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "description": "Id de esa entidad."
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Versión de la entidad después del cambio. Sirve para descartar eventos viejos."
        },
        "courseId": {
          "type": "string",
          "pattern": "^crs_[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "Curso al que pertenece el cambio. Obligatorio en los eventos de un curso; las reglas y el grupo FIFO lo usan."
        },
        "actorId": {
          "type": "string",
          "pattern": "^(system|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
          "description": "userId (sub de Cognito) de quien causó el cambio, o system."
        },
        "traceparent": {
          "type": "string",
          "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$",
          "description": "Contexto de traza W3C para seguir la petición en X-Ray."
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gradeId": {
          "type": "string",
          "pattern": "^grd_[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "Nota."
        },
        "gradeItemId": {
          "type": "string",
          "pattern": "^gri_[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "Columna del libro de notas."
        },
        "assignmentId": {
          "type": "string",
          "pattern": "^asg_[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "Tarea de origen, si la nota viene de una tarea."
        },
        "studentId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Alumno."
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "maxScore": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true
        }
      },
      "required": [
        "gradeId",
        "gradeItemId",
        "studentId",
        "score",
        "maxScore"
      ]
    }
  }
}
