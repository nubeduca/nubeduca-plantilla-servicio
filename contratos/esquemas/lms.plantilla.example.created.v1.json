{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "lms.plantilla.example.created.v1",
  "description": "SOLO PLANTILLA: evento del servicio de ejemplo. Bórralo al crear tu microservicio.",
  "type": "object",
  "required": ["metadata", "data"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["eventId", "tenantId", "occurredAt", "aggregateType", "aggregateId", "aggregateVersion", "actorId"],
      "additionalProperties": false,
      "properties": {
        "eventId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
        "tenantId": {"type": "string", "pattern": "^[a-z0-9-]{2,32}$"},
        "occurredAt": {"type": "string", "format": "date-time"},
        "aggregateType": {"type": "string", "enum": ["example"]},
        "aggregateId": {"type": "string", "minLength": 2, "maxLength": 64},
        "aggregateVersion": {"type": "integer", "minimum": 1},
        "courseId": {"type": "string", "pattern": "^crs_[0-9A-HJKMNP-TV-Z]{26}$"},
        "actorId": {"type": "string", "pattern": "^(system|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"},
        "traceparent": {"type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$"}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exampleId", "title"],
      "properties": {
        "exampleId": {"type": "string", "pattern": "^exm_[0-9A-HJKMNP-TV-Z]{26}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}
